<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>

<fx:root type="AnchorPane" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
      <children>
            <SplitPane dividerPositions="0.5" orientation="VERTICAL" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <AnchorPane maxHeight="50.0" minHeight="50.0" prefHeight="50.0">
                <children>
                    <ToolBar AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                        <items>
                            <CheckBox fx:id="captureRequestsCheckBox" mnemonicParsing="false" text="Capture:" />
                            <TextField fx:id="maxRequests" prefHeight="26.0" prefWidth="60.0" text="50" />
                            <Button mnemonicParsing="false" onAction="#clearCapturedData" text="Clear" />
                            <Button mnemonicParsing="false" onAction="#removeSelectedEntry" text="Remove" />
                            <Separator orientation="VERTICAL" prefHeight="200.0" />
                            <Button mnemonicParsing="false" onAction="#allowCapture" text="Allow" />
                            <Button mnemonicParsing="false" onAction="#denyCapture" text="Deny" />
                            <Separator orientation="VERTICAL" prefHeight="200.0" />
                            <Button mnemonicParsing="false" onAction="#allowCaptureHost" text="Allow host" />
                            <Button mnemonicParsing="false" onAction="#denyCaptureHost" text="Deny host" />
                            <Separator orientation="VERTICAL" prefHeight="200.0" />
                            <Button mnemonicParsing="false" onAction="#allowCapturePort" text="Allow port" />
                            <Button mnemonicParsing="false" onAction="#denyCapturePort" text="Deny port" />
                        <Separator orientation="VERTICAL" prefHeight="200.0" />
                        <MenuButton fx:id="captureFilterMenuButton" mnemonicParsing="false" text="Filter">
                          <items>
                            <CheckMenuItem fx:id="matchedAllowedMenuItem" mnemonicParsing="false" onAction="#captureFilterChange" selected="true" text="Matched/Allowed" />
                            <CheckMenuItem fx:id="matchedProhibitedMenuItem" mnemonicParsing="false" onAction="#captureFilterChange" selected="true" text="Matched/Prohibited" />
                            <CheckMenuItem fx:id="unmatchedAllowedMenuItem" mnemonicParsing="false" onAction="#captureFilterChange" selected="true" text="Unmatched/Allowed" />
                            <CheckMenuItem fx:id="unmatchedProhibitedMenuItem" mnemonicParsing="false" onAction="#captureFilterChange" selected="true" text="Unmatched/Prohibited" />
                          </items>
                        </MenuButton>
                        </items>
                    </ToolBar>
                </children>
            </AnchorPane>
            <AnchorPane>
                <TableView fx:id="capturedRequestsTable" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <columns>
                        <TableColumn minWidth="500.0" prefWidth="500.0" text="Host">
                            <cellValueFactory>
                                <PropertyValueFactory property="host" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn minWidth="200.0" prefWidth="200.0" text="Port">
                            <cellValueFactory>
                                <PropertyValueFactory property="port" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn minWidth="250.0" prefWidth="220.0" text="Last filter result">
                            <cellValueFactory>
                                <PropertyValueFactory property="filterResult" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="lastAccessColumn" minWidth="250.0" prefWidth="250.0" sortType="DESCENDING" text="Last access">
                            <cellValueFactory>
                                <PropertyValueFactory property="lastAccess" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn minWidth="100.0" prefWidth="100.0" sortType="DESCENDING" text="Count">
                            <cellValueFactory>
                                <PropertyValueFactory property="count" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn minWidth="250.0" prefWidth="250.0" text="Last from IP">
                            <cellValueFactory>
                                <PropertyValueFactory property="from" />
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
            </AnchorPane>
            </SplitPane>
      </children>
</fx:root>
